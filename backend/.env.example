# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: override the default model in backend/llm/gemini_chat.py
GEMINI_MODEL=
# Optional: seconds to wait for each Gemini call (default 30)
GEMINI_TIMEOUT_SECONDS=
# Optional: Gemini calls allowed per minute / per 24 hours, per server process (defaults 10 / 500; 0 = no limit)
GEMINI_RPM=
GEMINI_RPD=

BACKEND_PY_VERSION= # Optional
BACKEND_LOG_PATH=   # Optional, default to backend/logs/backend.log
SEATSAERO_TOKEN=
SEATSAERO_BASE_URL=https://seats.aero/partnerapi

# SerpApi key for cash fares / value ratings (https://serpapi.com); optional
SERPAPI_KEY=
# Optional: SerpApi cash-fare lookups per search for value ratings (default 4; 0 = off)
SERPAPI_LOOKUPS_PER_SEARCH=
